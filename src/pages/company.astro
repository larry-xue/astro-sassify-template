---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
---

<Layout title="About Our Agency - EUROGATE">
  <Header />
  <main>
    <div class="text-center mb-12 pt-28 md:pt-36">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        About <span class="text-blue-600 dark:text-blue-400">EUROGATE</span>
      </h1>
    </div>
    
    <section class="py-16 bg-white dark:bg-secondary-900">
      <div class="container-custom">
        <div class="grid md:grid-cols-2 gap-12 items-center mb-24">

          <!-- Text Content -->
          <div>
            <span class="inline-block px-4 py-1 rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-400 font-medium text-sm mb-4">
              Our Story
            </span>
            <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">
              Bridging Dreams to Global Opportunities
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              EUROGATE is an Uzbekistan-based consulting agency specializing in global recruitment, work & travel, and study abroad programs. Our mission is to make international opportunities accessible to students and professionals from Uzbekistan.
            </p>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Led by a team with real international experience in Europe, we bring firsthand knowledge and insights to every guidance, scholarship, and career placement we provide. Our approach combines expertise with personalized support to help each individual succeed abroad.
            </p>
            <p class="text-gray-600 dark:text-gray-300">
              Over the years, we have guided hundreds of applicants through scholarships, visas, and career opportunities, earning trust and recognition within educational and professional communities. Today, EUROGATE continues to empower ambitious individuals to achieve their global dreams while contributing to positive social impact in Uzbekistan.
            </p>
          </div>
          <div class="rounded-lg overflow-hidden shadow-xl">
            <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1000&q=80" alt="Sassify Team" class="w-full h-auto" />
          </div>
        </div>
        
        <div class="mb-24">
          <div class="text-center mb-12">
            <span class="inline-block px-4 py-1 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300 font-medium text-sm mb-4">
              Our Values
            </span>
            <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">What We Stand For</h2>
            <p class="text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
              Our values, mission, and vision guide everything we do, from supporting students and professionals to driving positive social impact in Uzbekistan.
            </p>
          </div>
          
          <div class="grid md:grid-cols-3 gap-8">
            <!-- Trust & Transparency -->
            <div class="card p-6 border border-gray-200 dark:border-gray-700">
              <div class="rounded-full bg-primary-100 dark:bg-primary-900 p-3 w-12 h-12 flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Trust & Transparency</h3>
              <p class="text-gray-600 dark:text-gray-300">
                We uphold integrity in all we do. EUROGATE is open about our processes, support, and policies, ensuring students and professionals can rely on us with confidence.
              </p>
            </div>

            <!-- Vision -->
            <div class="card p-6 border border-gray-200 dark:border-gray-700">
              <div class="rounded-full bg-primary-100 dark:bg-primary-900 p-3 w-12 h-12 flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Our Vision</h3>
              <p class="text-gray-600 dark:text-gray-300">
                To position Uzbekistan as a trusted source of global talent while supporting national poverty alleviation initiatives.
              </p>
            </div>

            <!-- Customer Success -->
            <div class="card p-6 border border-gray-200 dark:border-gray-700">
              <div class="rounded-full bg-primary-100 dark:bg-primary-900 p-3 w-12 h-12 flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Customer Success</h3>
              <p class="text-gray-600 dark:text-gray-300">
                Our customers' success is our success. We're committed to providing the support, resources, and tools our customers need to achieve their goals.
              </p>
            </div>
          </div>
        </div>
        
        <div class="mb-24">
          <div class="text-center mb-12">
            <span class="inline-block px-4 py-1 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300 font-medium text-sm mb-4">
              Leadership Team
            </span>
            <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Meet Our Leaders</h2>
            <p class="text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
              Our diverse team of leaders brings decades of experience and a shared passion for innovation.
            </p>
          </div>
          
          <div class="grid md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="rounded-full overflow-hidden w-32 h-32 mx-auto mb-4">
                <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="Sanjar Mustafakulov" class="w-full h-full object-cover" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">Sanjar Mustafakulov</h3>
              <p class="text-primary-600 dark:text-primary-400 mb-2">CEO & Co-Founder</p>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                With over 10 years of experience in visa and consular services, Sanjar leads our company with vision and passion.
              </p>
            </div>
            
            <div class="text-center">
              <div class="rounded-full overflow-hidden w-32 h-32 mx-auto mb-4">
                <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="Furkat Gafurov" class="w-full h-full object-cover" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">Furkat Gafurov</h3>
              <p class="text-primary-600 dark:text-primary-400 mb-2">CTO & Co-Founder</p>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                Furkat's extensive international experience in software development global education drives EUROGATE's technological innovation and Study Abroad strategies.
              </p>
            </div>
            
            
            <div class="text-center">
              <div class="rounded-full overflow-hidden w-32 h-32 mx-auto mb-4">
                <img src="https://randomuser.me/api/portraits/men/67.jpg" alt="David Rodriguez" class="w-full h-full object-cover" />
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">David Rodriguez</h3>
              <p class="text-primary-600 dark:text-primary-400 mb-2">COO</p>
              <p class="text-gray-600 dark:text-gray-300 text-sm">
                David ensures our operations run smoothly and efficiently, enabling us to deliver exceptional value to our customers.
              </p>
            </div>
            
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout> 
