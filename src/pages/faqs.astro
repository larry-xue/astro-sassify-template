---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
---

<Layout title="Frequently Asked Questions - EUROGATE">
  <Header />
  <main>
    <div class="text-center mb-12 pt-28 md:pt-36">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Frequently Asked <span class="text-blue-600 dark:text-blue-400">Questions</span>
      </h1>
      <p class="text-gray-700 dark:text-gray-300">
        Find answers to common questions about EUROGATE and our services.
      </p>
    </div>
    
    <section class="py-16 bg-white dark:bg-gray-800">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <!-- FAQ Categories Navigation -->
          <div class="flex flex-wrap justify-center gap-4 mb-12">
            <a href="#general" class="px-4 py-2 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-400 font-medium text-sm hover:bg-blue-200 dark:hover:bg-blue-800 transition-colors">
              General
            </a>
            <a href="#services" class="px-4 py-2 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-400 font-medium text-sm hover:bg-blue-200 dark:hover:bg-blue-800 transition-colors">
              Services
            </a>
            <a href="#visas" class="px-4 py-2 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-400 font-medium text-sm hover:bg-blue-200 dark:hover:bg-blue-800 transition-colors">
              Visas
            </a>
          </div>

          <!-- General FAQs -->
          <div id="general" class="mb-16">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 flex items-center">
              <span class="inline-block rounded-full bg-primary-100 dark:bg-primary-900 p-2 mr-3">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </span>
              General Questions
            </h2>

            <div class="space-y-6">
              <div class="card p-6 border border-gray-200 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Who can contact EUROGATE?</h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                  Anyone is welcome, but generally students and professionals who are seeking opportunities to study, work, or gain international experience abroad.
                </p>
              </div>
            </div>
          </div>

          <!-- Services FAQs -->
          <div id="services" class="mb-16">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 flex items-center">
              <span class="inline-block rounded-full bg-primary-100 dark:bg-primary-900 p-2 mr-3">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                </svg>
              </span>
              Key Services
            </h2>

            <div class="space-y-6">
              <div class="card p-6 border border-gray-200 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">What are the key services of EUROGATE?</h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                  EUROGATE offers a wide range of services to help students and professionals succeed abroad. This includes scholarship guidance, visa support, university applications, and career counseling. Each service is tailored to your needs, and you can find full details on our <a href="/services" class="text-primary-600 dark:text-primary-400 hover:underline">services page</a>.
                </p>
              </div>
            </div>
          </div>

          <!-- Visas FAQs -->
          <div id="visas" class="mb-16">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 flex items-center">
              <span class="inline-block rounded-full bg-primary-100 dark:bg-primary-900 p-2 mr-3">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"/>
                </svg>
              </span>
              Visa Assistance
            </h2>

            <div class="space-y-6">
              <div class="card p-6 border border-gray-200 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Do you assist with visa applications?</h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                  Yes! EUROGATE guides applicants step by step to ensure the visa application process is smooth and successful.
                </p>
              </div>
            </div>
          </div>

          <!-- Still have questions -->
          <div class="text-center mt-16">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Still have questions?</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
              Our team is here to help. Contact us and we'll get back to you as soon as possible.
            </p>
            <a href="/contact" class="btn-blue">Contact Support</a>
          </div>

        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
